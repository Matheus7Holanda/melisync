# Copie os nomes abaixo para configurar as variáveis de ambiente reais.
# NUNCA preencha valores reais neste arquivo — ele é versionado no Git.
# No Eclipse, configure os valores em: Run > Run Configurations >
# [sua config Java Application] > aba Environment.

# ---------------------------------------------------------------------------
# Mercado Livre — obtidas em https://developers.mercadolivre.com.br
# (Minhas aplicações > sua aplicação > Autenticação e segurança)
# ---------------------------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Deve ser IDÊNTICA à URI de redirect cadastrada no Mercado Livre.
# Durante o desenvolvimento local, use um domínio HTTPS do ngrok
# (o Mercado Livre não aceita "localhost" no redirect_uri):
# ngrok http 8080 --url https://SEU-DOMINIO.ngrok-free.dev
ML_REDIRECT_URI=https://SEU-DOMINIO.ngrok-free.dev/auth/mercadolivre/callback

# Seu ID de vendedor. Depois de autorizar o app (GET /auth/mercadolivre/iniciar),
# descubra o valor acessando (no navegador):
# https://api.mercadolibre.com/users/me?access_token=SEU_ACCESS_TOKEN
# O access_token pode ser consultado no H2 Console (tabela ML_O_AUTH_TOKEN).
ML_SELLER_ID=

# ---------------------------------------------------------------------------
# VHSYS — solicitar ao suporte VHSYS o access_token, o secret_access_token,
# e confirmar o path real dos endpoints de produto e de PDV/venda
# (ver TODOs em VhsysClient.java e VhsysPdvRequestDTO.java).
# ---------------------------------------------------------------------------
VHSYS_ACCESS_TOKEN=
VHSYS_SECRET_ACCESS_TOKEN=
VHSYS_API_BASE_URL=https://ns.vhsys.com.br/api/v2
VHSYS_ID_PDV=1
