# Copie os nomes abaixo para configurar as variáveis de ambiente reais.
# NUNCA preencha valores reais neste arquivo — ele é versionado no Git.
# No Eclipse, configure os valores em: Run > Run Configurations >
# [sua config Java Application] > aba Environment.

# ---------------------------------------------------------------------------
# Mercado Livre — obtidas em https://developers.mercadolivre.com.br
# (Minhas aplicações > sua aplicação > Autenticação e segurança)
# ---------------------------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Deve ser IDÊNTICA à URI de redirect cadastrada no Mercado Livre.
# Durante o desenvolvimento local, use um domínio HTTPS do ngrok
# (o Mercado Livre não aceita "localhost" no redirect_uri):
# ngrok http 8080 --url https://SEU-DOMINIO.ngrok-free.dev
ML_REDIRECT_URI=https://SEU-DOMINIO.ngrok-free.dev/auth/mercadolivre/callback

# Seu ID de vendedor. Depois de autorizar o app (GET /auth/mercadolivre/iniciar),
# descubra o valor acessando (no navegador):
# https://api.mercadolibre.com/users/me?access_token=SEU_ACCESS_TOKEN
# O access_token pode ser consultado no H2 Console (tabela ML_O_AUTH_TOKEN).
ML_SELLER_ID=

# OPCIONAL (padrao 10): quantos dias antes do dia consultado buscamos pedidos.
# Um envio pode sair dias depois do pedido; a API do ML nao permite buscar
# envios por data de saida, entao olhamos pedidos recentes e filtramos pelo
# historico do envio. Aumente se tiver envios que demoram mais pra sair.
ML_DIAS_RETROATIVOS=10

# OPCIONAL (padrao ENVIOS_DE_HOJE): o que significa "envios do dia".
#   ENVIOS_DE_HOJE -> lista "Envios de hoje" do painel do ML (prontos para despachar)
#   CRIACAO_PEDIDO -> pedidos pagos criados no dia (mais simples; bom p/ validar)
#   SAIDA_ENVIO    -> envios que sairam no dia (usa ML_DIAS_RETROATIVOS)
# Tambem da pra escolher por consulta: ...?data=2026-10-10&criterio=SAIDA_ENVIO
ML_CRITERIO_DATA=ENVIOS_DE_HOJE

# ---------------------------------------------------------------------------
# VHSYS -- access_token e secret_access_token obtidos com o suporte VHSYS.
# Confirmado na documentacao oficial: base URL https://api.vhsys.com/v2,
# autenticacao por HEADER (nao query param). Nao existe "id_pdv" na API --
# uma venda balcao e criada em duas chamadas (cabecalho + produtos).
# ---------------------------------------------------------------------------
VHSYS_ACCESS_TOKEN=
VHSYS_SECRET_ACCESS_TOKEN=
VHSYS_API_BASE_URL=https://api.vhsys.com/v2
VHSYS_USER_AGENT=integracao-vhsys-ml/1.0
